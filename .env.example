# Server-only: never exposed to the browser (used only in Server
# Components and Route Handlers to reach the NestJS backend).
API_URL=http://localhost:3001

# Client-exposed: Supabase's anon key is safe to expose (RLS-gated) and the
# JS client needs it in the browser for Realtime subscriptions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
